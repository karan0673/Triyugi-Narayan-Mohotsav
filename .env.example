# Copy to .env (never commit .env)
NODE_ENV=development

# API
PORT=4000
WEB_ORIGIN=http://localhost:3000
API_URL=http://localhost:4000

# MongoDB (local replica set from docker-compose.yml)
MONGODB_URI=mongodb://localhost:27017/triyugi?replicaSet=rs0&directConnection=true

# Auth (generate long random strings, e.g. openssl rand -hex 48)
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Email (Resend free tier: keep daily limit under 100)
RESEND_API_KEY=
EMAIL_FROM="Triyugi Narayan Mohotsav <invites@yourdomain.com>"
EMAIL_DAILY_LIMIT=90

# Public site URL used in invitation and RSVP links
APP_URL=http://localhost:3000

# AWS (Phase 3, media uploads)
AWS_REGION=ap-south-1
S3_BUCKET=
